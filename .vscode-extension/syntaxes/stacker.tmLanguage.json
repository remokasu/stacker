{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Stacker",
  "scopeName": "source.stacker",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#symbols"
    },
    {
      "include": "#words-0"
    },
    {
      "include": "#words-1"
    },
    {
      "include": "#words-2"
    },
    {
      "include": "#words-3"
    },
    {
      "include": "#words-4"
    },
    {
      "include": "#words-5"
    },
    {
      "include": "#words-6"
    },
    {
      "include": "#words-7"
    },
    {
      "include": "#words-8"
    },
    {
      "include": "#words-9"
    },
    {
      "include": "#words-10"
    },
    {
      "include": "#words-11"
    },
    {
      "include": "#words-12"
    },
    {
      "include": "#words-13"
    },
    {
      "include": "#words-14"
    },
    {
      "include": "#words-15"
    },
    {
      "include": "#words-16"
    },
    {
      "include": "#blocks"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.stacker",
          "begin": "#\\|",
          "end": "\\|#",
          "patterns": [
            {
              "include": "#comments"
            }
          ]
        },
        {
          "name": "comment.line.number-sign.stacker",
          "match": "#(?!\\|).*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.triple.stacker",
          "begin": "\"\"\"",
          "end": "\"\"\"",
          "patterns": [
            {
              "include": "#escapes"
            }
          ]
        },
        {
          "name": "string.quoted.triple.stacker",
          "begin": "'''",
          "end": "'''",
          "patterns": [
            {
              "include": "#escapes"
            }
          ]
        },
        {
          "name": "string.quoted.double.stacker",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "include": "#escapes"
            }
          ]
        },
        {
          "name": "string.quoted.single.stacker",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "include": "#escapes"
            }
          ]
        }
      ]
    },
    "escapes": {
      "patterns": [
        {
          "name": "constant.character.escape.stacker",
          "match": "\\\\."
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.complex.stacker",
          "match": "(?<![\\w.?!-])(?:(?<![\\w?!-])-)?[0-9]+(?:\\.[0-9]+)?(?:[+-][0-9]+(?:\\.[0-9]+)?)?[jJ](?![\\w.?!-])"
        },
        {
          "name": "constant.numeric.hex.stacker",
          "match": "(?<![\\w.?!-])(?:(?<![\\w?!-])-)?0[xX][0-9a-fA-F_]+(?![\\w.?!-])"
        },
        {
          "name": "constant.numeric.octal.stacker",
          "match": "(?<![\\w.?!-])(?:(?<![\\w?!-])-)?0[oO][0-7_]+(?![\\w.?!-])"
        },
        {
          "name": "constant.numeric.binary.stacker",
          "match": "(?<![\\w.?!-])(?:(?<![\\w?!-])-)?0[bB][01_]+(?![\\w.?!-])"
        },
        {
          "name": "constant.numeric.float.stacker",
          "match": "(?<![\\w.?!-])(?:(?<![\\w?!-])-)?[0-9][0-9_]*(?:\\.[0-9_]+)?[eE][+-]?[0-9]+(?![\\w.?!-])|(?<![\\w.?!-])(?:(?<![\\w?!-])-)?[0-9][0-9_]*\\.[0-9_]+(?![\\w.?!-])"
        },
        {
          "name": "constant.numeric.integer.stacker",
          "match": "(?<![\\w.?!-])(?:(?<![\\w?!-])-)?[0-9][0-9_]*(?![\\w.?!-])"
        }
      ]
    },
    "symbols": {
      "patterns": [
        {
          "name": "constant.other.symbol.stacker",
          "match": "(?<![^\\s\\[\\]{}()]):[^\\s\\[\\]{}()\\\"'#;:$]+"
        }
      ]
    },
    "words-0": {
      "patterns": [
        {
          "name": "keyword.control.stacker",
          "match": "(?<![\\w?!-])(iferror|dolist|ifelse|break|times|while|cond|loop|do|if)(?![\\w?!-])"
        }
      ]
    },
    "words-1": {
      "patterns": [
        {
          "name": "keyword.control.definition.stacker",
          "match": "(?<![\\w?!-])(defmacro|lambda|alias|defun)(?![\\w?!-])"
        }
      ]
    },
    "words-2": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.stacker",
          "match": "(?<![\\w?!-])(global|set)(?![\\w?!-])"
        },
        {
          "name": "keyword.operator.assignment.stacker",
          "match": "(?<![^\\s\\[\\]{}()])(=)(?![^\\s\\[\\]{}()])"
        }
      ]
    },
    "words-3": {
      "patterns": [
        {
          "name": "keyword.operator.code.stacker",
          "match": "(?<![\\w?!-])(concat\\-block|macroexpand|collect|include|require|expand|gensym|symbol|apply|parse|eval|subn|sub)(?![\\w?!-])"
        }
      ]
    },
    "words-4": {
      "patterns": [
        {
          "name": "keyword.operator.arithmetic.stacker",
          "match": "(?<![\\w?!-])(neg)(?![\\w?!-])"
        },
        {
          "name": "keyword.operator.arithmetic.stacker",
          "match": "(?<![^\\s\\[\\]{}()])(\\+\\+|\\-\\-|//|%|\\*|\\+|\\-|/)(?![^\\s\\[\\]{}()])"
        }
      ]
    },
    "words-5": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.stacker",
          "match": "(?<![\\w?!-])(same\\?|neq|eq|ge|gt|le|lt)(?![\\w?!-])"
        },
        {
          "name": "keyword.operator.comparison.stacker",
          "match": "(?<![^\\s\\[\\]{}()])(!=|<=|==|>=|<|>)(?![^\\s\\[\\]{}()])"
        }
      ]
    },
    "words-6": {
      "patterns": [
        {
          "name": "keyword.operator.logical.stacker",
          "match": "(?<![\\w?!-])(and|not|or)(?![\\w?!-])"
        },
        {
          "name": "keyword.operator.logical.stacker",
          "match": "(?<![^\\s\\[\\]{}()])(\\&\\&|\\|\\|)(?![^\\s\\[\\]{}()])"
        }
      ]
    },
    "words-7": {
      "patterns": [
        {
          "name": "keyword.operator.bitwise.stacker",
          "match": "(?<![\\w?!-])(band|bxor|bin|bor|dec|hex|oct)(?![\\w?!-])"
        },
        {
          "name": "keyword.operator.bitwise.stacker",
          "match": "(?<![^\\s\\[\\]{}()])(<<|>>|\\~)(?![^\\s\\[\\]{}()])"
        }
      ]
    },
    "words-8": {
      "patterns": [
        {
          "name": "keyword.operator.math.stacker",
          "match": "(?<![\\w?!-])(radians|randint|uniform|roundn|acosh|asinh|atanh|floor|log10|polar|round|acos|asin|atan|cbrt|ceil|comb|conj|cosh|dice|frac|imag|log2|perm|rand|real|sinh|sqrt|tanh|abs|arg|cos|exp|gcd|lcm|log|ncr|npr|sin|tan)(?![\\w?!-])"
        },
        {
          "name": "keyword.operator.math.stacker",
          "match": "(?<![^\\s\\[\\]{}()])(!|\\^)(?![^\\s\\[\\]{}()])"
        }
      ]
    },
    "words-9": {
      "patterns": [
        {
          "name": "keyword.operator.stack.stacker",
          "match": "(?<![\\w?!-])(clear|count|depth|drop2|dropn|unrot|disp|drop|dup2|dupn|over|pick|roll|swap|ans|dup|ins|nip|rev|rot)(?![\\w?!-])"
        }
      ]
    },
    "words-10": {
      "patterns": [
        {
          "name": "keyword.operator.list.stacker",
          "match": "(?<![\\w?!-])(enumerate|array\\-of|reversed|append!|empty\\?|filter|reduce|sorted|values|array|listn|null\\?|pair\\?|slice|cons|del!|dict|fold|has\\?|keys|list|pop!|put!|all|any|at!|car|cdr|get|len|map|max|min|nth|seq|sum|zip|at)(?![\\w?!-])"
        }
      ]
    },
    "words-11": {
      "patterns": [
        {
          "name": "keyword.operator.string.stacker",
          "match": "(?<![\\w?!-])(starts\\-with\\?|ends\\-with\\?|contains|replace|concat|format|lstrip|rstrip|search|subseq|lower|split|strip|title|upper|words|join|asc|chr)(?![\\w?!-])"
        }
      ]
    },
    "words-12": {
      "patterns": [
        {
          "name": "keyword.operator.type.stacker",
          "match": "(?<![\\w?!-])(complex\\?|complex|number\\?|symbol\\?|array\\?|float\\?|bool\\?|dict\\?|float|list\\?|bool|int\\?|str\\?|type|int|str)(?![\\w?!-])"
        }
      ]
    },
    "words-13": {
      "patterns": [
        {
          "name": "keyword.operator.io.stacker",
          "match": "(?<![\\w?!-])(append\\-to\\-file|read\\-from\\-file|write\\-to\\-file|file\\-exists|read\\-lines|newline|printc|print|echo|read|time|cat|pwd|cd|ls)(?![\\w?!-])"
        }
      ]
    },
    "words-14": {
      "patterns": [
        {
          "name": "keyword.operator.system.stacker",
          "match": "(?<![\\w?!-])(disable_all_plugins|disable_plugin|exit\\-code|operators|version|macros|abort|funcs|exit|vars)(?![\\w?!-])"
        }
      ]
    },
    "words-15": {
      "patterns": [
        {
          "name": "support.function.prelude.stacker",
          "match": "(?<![\\w?!-])(mean)(?![\\w?!-])"
        }
      ]
    },
    "words-16": {
      "patterns": [
        {
          "name": "constant.language.stacker",
          "match": "(?<![\\w?!-])(false|null|true|inf|nan|phi|tau|pi|e)(?![\\w?!-])"
        }
      ]
    },
    "blocks": {
      "patterns": [
        {
          "name": "meta.block.stacker",
          "begin": "\\{",
          "end": "\\}",
          "patterns": [
            {
              "include": "$self"
            }
          ]
        },
        {
          "name": "meta.block.stacker",
          "begin": "\\(",
          "end": "\\)",
          "patterns": [
            {
              "include": "$self"
            }
          ]
        },
        {
          "name": "meta.list.stacker",
          "begin": "\\[",
          "end": "\\]",
          "patterns": [
            {
              "include": "$self"
            }
          ]
        }
      ]
    }
  }
}
