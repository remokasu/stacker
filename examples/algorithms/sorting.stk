# ===== Comparing sorted vs original =====
"" echo
"=== Comparing Lists ===" echo

"Is [1,2,3,4,5] sorted?" echo
[1 2 3 4 5] dup sorted == echo
"Is [1,3,2,4] sorted?" echo
[1 3 2 4] dup sorted == echo

