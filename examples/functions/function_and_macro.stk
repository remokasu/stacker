# Functions, aliases and macros

# Function: runs on its own stack with named arguments, returns one value
{x y} {x y +} add defun
10 20 add echo  # Output: 30

# Alias: a named code snippet, run in place on the caller's stack
{2 ^ 3 * 5 +} {square_times_3_plus_5} alias
5 square_times_3_plus_5 echo  # Output: 80 (5^2 * 3 + 5)

# Macro: the body runs when the macro is called and builds the code to run.
# Arguments arrive as unevaluated code blocks; inside a block literal of the
# body, an argument name is replaced by the block passed in.
{cond body} {
    {cond eval not {body eval} if}
} {unless} defmacro

3 {0 >} {"not positive" echo} unless     # prints nothing
-3 {0 >} {"not positive" echo} unless    # Output: not positive

# See what a macro call becomes without running it
-3 {0 >} {"not positive" echo} {unless} macroexpand disp
